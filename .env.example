ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
HTB_APP_TOKEN=your-htb-app-token-here

# Hexstrike configuration
HEXSTRIKE_DIR=/home/kali/hexstrike-ai
HEXSTRIKE_PORT=8888

# Ollama host — where the harness CONNECTS to reach Ollama (Ollama is NOT
# containerized; it runs on the host with the GPUs). Canonical values:
#   Local (Docker Desktop / WSL): http://host.docker.internal:11434
#   Cloud / explicit box:         http://<host-or-ip>:11434
# NOTE: this OLLAMA_HOST is used for DIRECT (non-compose) runs. Under docker
# compose it is overridden by the compose `environment:` block — set
# CLANKER_OLLAMA_HOST there instead (default host.docker.internal). That name is
# deliberately distinct from the host's own OLLAMA_HOST=0.0.0.0:11434, which tells
# the Ollama *server* which interfaces to LISTEN on (set that as a Windows system
# env var and restart Ollama; firewall-scope 11434 to the Docker/WSL subnet).
OLLAMA_HOST=http://host.docker.internal:11434

# MCP overrides (optional — defaults are derived from HEXSTRIKE_DIR/PORT)
# MCP_COMMAND=/home/kali/hexstrike-ai/hexstrike-env/bin/python3
# MCP_ARGS=/home/kali/hexstrike-ai/hexstrike_mcp.py --server http://127.0.0.1:8888

# Brave Search MCP (optional — enables web search tools)
# BRAVE_API_KEY=your-brave-api-key-here

# ── LangSmith tracing ────────────────────────────────────────────────────────
# Traces every LLM call and tool invocation to LangSmith Studio (works for the
# local Ollama calls too). Get your key at https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-key-here
# LANGSMITH_PROJECT=filthy-clanker

# ── Eval egress sandbox ──────────────────────────────────────────────────────
# The nyu-bench eval container blocks the AGENT from reaching arbitrary public
# hosts by default (it can still reach local Ollama, the challenge containers,
# and an allowlist: Brave Search + LangSmith + npm — see evals/nyu_bench/sandbox/).
# Set to 1 ONLY when you deliberately want the agent to have full internet.
# CLANKER_ALLOW_INTERNET=0
