ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
HTB_APP_TOKEN=your-htb-app-token-here

# Hexstrike configuration
HEXSTRIKE_DIR=/home/kali/hexstrike-ai
HEXSTRIKE_PORT=8888

# MCP overrides (optional — defaults are derived from HEXSTRIKE_DIR/PORT)
# MCP_COMMAND=/home/kali/hexstrike-ai/hexstrike-env/bin/python3
# MCP_ARGS=/home/kali/hexstrike-ai/hexstrike_mcp.py --server http://127.0.0.1:8888

# Brave Search MCP (optional — enables web search tools)
# BRAVE_API_KEY=your-brave-api-key-here

# ── LangSmith tracing ────────────────────────────────────────────────────────
# Traces every LLM call and tool invocation to LangSmith Studio.
# Get your key at https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-key-here
# LANGSMITH_PROJECT=filthy-clanker
